# ---- База данных ----
DATABASE_URL=postgresql+asyncpg://lessonlens:lessonlens@127.0.0.1:5432/lessonlens
DATABASE_URL_SYNC=postgresql+psycopg://lessonlens:lessonlens@127.0.0.1:5432/lessonlens

# ---- Приложение ----
APP_ENV=dev                      # dev | prod | test
SECRET_KEY=change-me-please-32-bytes-minimum   # ОБЯЗАТЕЛЬНО заменить: python -c "import secrets; print(secrets.token_urlsafe(48))"; в APP_ENV=prod с этим значением API не стартует
PUBLIC_BASE_URL=http://localhost:5173      # адрес фронтенда (для magic-ссылок родителям)
API_BASE_URL=http://localhost:8000
MEDIA_ROOT=./media               # локальное хранилище загрузок, аудио, кадров
CORS_ORIGINS=http://localhost:5173

# ---- Пайплайн ----
PIPELINE_MODE=inline             # inline (фоновая задача в API-процессе) | worker (отдельный процесс `python -m app.worker`)
MAX_UPLOAD_MB=2048
KEYFRAME_INTERVAL_SEC=30         # периодическая выборка кадров
KEYFRAME_SCENE_THRESHOLD=0.06    # доля неподвижных пикселей, изменившихся между сканами = новый слайд
KEYFRAME_MAX=40                  # максимум кадров на урок, передаваемых в LLM
KEYFRAME_SCAN_MAX_GAP_SEC=20     # если опорные кадры видео реже — полное (но параллельное) сканирование
PIPELINE_HEARTBEAT_SEC=20        # как часто обновлять «Распознаём речь · 3 мин 20 с» во время долгих этапов

# ---- Провайдеры ----
# STT: mock | whisper_local | openai | deepgram | assemblyai | google | elevenlabs | yandex
STT_PROVIDER=mock
WHISPER_MODEL=small               # для whisper_local: tiny|base|small|medium|large-v3|large-v3-turbo
WHISPER_DEVICE=auto              # auto (GPU, если есть) | cpu | cuda
WHISPER_BEAM_SIZE=1              # 1 = жадное декодирование (~2x быстрее beam 5)
WHISPER_BATCH_SIZE=              # пусто: 16 на GPU, 0 на CPU; >0 — пакетный режим faster-whisper
WHISPER_CPU_THREADS=             # пусто = все ядра
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# LLM (анализ транскрипта + кадров): mock | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- Мессенджеры ----
TELEGRAM_BOT_TOKEN=              # пусто = бот выключен, уведомления пишутся в лог/БД
TELEGRAM_MODE=polling            # polling | webhook
TELEGRAM_WEBHOOK_URL=
WHATSAPP_ENABLED=false           # Meta Cloud API, заготовка
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
TELEGRAM_WEBHOOK_SECRET=         # режим webhook: секрет в пути /api/telegram/webhook/{secret}
TELEGRAM_BOT_USERNAME=           # необязательно: имя бота для deep-link, если не хотим вызывать getMe
MESSAGING_PROVIDER=              # пусто = реальные провайдеры по каналу; mock = все сообщения в память (тесты, сидирование)

# ---- Дополнительно (есть разумные значения по умолчанию) ----
STAFF_TOKEN_TTL_DAYS=7
PARENT_TOKEN_TTL_DAYS=30
MAGIC_LINK_TTL_HOURS=72
MEDIA_TOKEN_TTL_MINUTES=10       # короткоживущий токен для ?access_token= у /api/media/* (кадры, видео)
PIPELINE_STALE_MINUTES=30        # урок в промежуточном статусе дольше этого считается брошенным и может быть перезапущен
RATE_LIMIT_ENABLED=true          # лимиты на /api/auth/login, /api/auth/register-center, /api/parent/auth/exchange (в APP_ENV=test выключены)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT_SEC=3600
LLM_MAX_FRAMES=20                # сколько кадров уходит в мультимодальный промпт
LLM_EFFORT=high                  # anthropic: low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SEC=600
OPENAI_LLM_MODEL=gpt-5           # LLM_PROVIDER=openai
OPENAI_STT_MODEL=whisper-1       # STT_PROVIDER=openai: whisper-1 | gpt-4o-transcribe | gpt-4o-transcribe-diarize
DEEPGRAM_MODEL=nova-3
ELEVENLABS_STT_MODEL=scribe_v1
YANDEX_STT_MODEL=general
WORKER_POLL_INTERVAL_SEC=2       # PIPELINE_MODE=worker
WORKER_CONCURRENCY=2             # сколько уроков воркер обрабатывает одновременно (1 для whisper_local на CPU)
WORKER_STALE_JOB_HOURS=3
