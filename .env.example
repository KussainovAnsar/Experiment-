# ---- База данных ----
DATABASE_URL=postgresql+asyncpg://lessonlens:lessonlens@127.0.0.1:5432/lessonlens
DATABASE_URL_SYNC=postgresql+psycopg://lessonlens:lessonlens@127.0.0.1:5432/lessonlens

# ---- Приложение ----
APP_ENV=dev                      # dev | prod | test
SECRET_KEY=change-me-please-32-bytes-minimum   # ОБЯЗАТЕЛЬНО заменить: python -c "import secrets; print(secrets.token_urlsafe(48))"; в APP_ENV=prod с этим значением API не стартует
PUBLIC_BASE_URL=http://localhost:5173      # адрес фронтенда (для magic-ссылок родителям)
API_BASE_URL=http://localhost:8000
MEDIA_ROOT=./media               # локальное хранилище загрузок, аудио, кадров
CORS_ORIGINS=http://localhost:5173

# ---- Пайплайн ----
PIPELINE_MODE=inline             # inline (фоновая задача в API-процессе) | worker (отдельный процесс `python -m app.worker`)
MAX_UPLOAD_MB=2048
KEYFRAME_INTERVAL_SEC=30         # периодическая выборка кадров
KEYFRAME_SCENE_THRESHOLD=0.06    # доля неподвижных пикселей, изменившихся между сканами = новый слайд
KEYFRAME_MAX=40                  # максимум кадров на урок, передаваемых в LLM
KEYFRAME_SCAN_MAX_GAP_SEC=20     # если опорные кадры видео реже — полное (но параллельное) сканирование
PIPELINE_HEARTBEAT_SEC=20        # как часто обновлять «Распознаём речь · 3 мин 20 с» во время долгих этапов

# ---- Провайдеры ----
# STT: mock | whisper_local | openai | deepgram | assemblyai | google | elevenlabs | yandex | revolver
STT_PROVIDER=mock
WHISPER_MODEL=small               # для whisper_local: tiny|base|small|medium|large-v3|large-v3-turbo
WHISPER_DEVICE=auto              # auto (GPU, если есть) | cpu | cuda
WHISPER_BEAM_SIZE=1              # 1 = жадное декодирование (~2x быстрее beam 5)
WHISPER_BATCH_SIZE=              # пусто: 16 на GPU, 0 на CPU; >0 — пакетный режим faster-whisper
WHISPER_CPU_THREADS=             # пусто = все ядра
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# LLM (анализ транскрипта + кадров): mock | anthropic | openai | revolver
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- Револьвер бесплатных ИИ (STT_PROVIDER=revolver / LLM_PROVIDER=revolver) ----
# Только бесплатные тарифы, платного запасного провайдера нет. Эндпоинт включается, только если задан его ключ.
# Перебор по порядку; при 429/5xx/таймауте/битом JSON эндпоинт «остывает» (Retry-After или REVOLVER_COOLDOWN_SEC)
# и берётся следующий. Если всё исчерпано — урок падает с «Бесплатные лимиты ... исчерпаны, повторите позже»,
# в PIPELINE_MODE=worker задача сама встаёт на повтор к моменту, когда освободится первый эндпоинт.
# ⚠️ Бесплатные тарифы Gemini, Mistral и др. используют запросы для обучения — реальные записи детей только
# с согласием и для демо/пилота (docs/PROVIDERS.md §6, docs/LEGAL_KZ.md).
GROQ_API_KEY=                    # бесплатный план навсегда: Whisper (STT) + qwen3.8-27b (3 кадра) + gpt-oss-120b (без кадров). https://console.groq.com/keys
GEMINI_API_KEY=                  # бесплатный tier Google AI Studio, лучший vision-вариант. https://aistudio.google.com/apikey
OPENROUTER_API_KEY=              # только модели с суффиксом :free (~50 запросов/день без пополнения). https://openrouter.ai/settings/keys
MISTRAL_API_KEY=                 # бесплатный план Experiment (нужен телефон, данные идут в обучение). https://console.mistral.ai/api-keys
NVIDIA_API_KEY=                  # бесплатный доступ разработчика build.nvidia.com (~40 запросов/мин). https://build.nvidia.com/
CEREBRAS_API_KEY=                # бесплатный tier (малые лимиты, ~5 запросов/мин). https://cloud.cerebras.ai/
SAMBANOVA_API_KEY=               # в порядок по умолчанию НЕ входит (статус бесплатного тарифа не подтверждён); только явно в REVOLVER_LLM_ORDER. https://cloud.sambanova.ai/apis
# DEEPGRAM_API_KEY / ASSEMBLYAI_API_KEY / ELEVENLABS_API_KEY выше: в STT-револьвере используются, только если заданы.
# Это разовый СТАРТОВЫЙ кредит (размер — на сайте провайдера) или малая месячная квота, а не вечный бесплатный тариф.
# Порядок: provider:model[@кадров], через запятую; @0 = модель без зрения (получит только транскрипт,
# в анализе будет пометка «Кадры урока не учитывались»). Пусто = встроенный порядок:
# gemini:gemini-3.8-flash@16,gemini:gemini-3.6-flash@16,gemini:gemini-3.5-flash@16,gemini:gemini-3.1-flash-lite@16,gemini:gemini-3.5-flash-lite@16,
# openrouter:google/gemma-4-31b-it:free@8,openrouter:nvidia/nemotron-3.5-super-vl:free@8,
# mistral:mistral-medium-latest@8,nvidia:nvidia/nemotron-3.5-super-vl-120b-a12b@4,cerebras:qwen-3.8-27b@5,
# groq:qwen/qwen3.8-27b@3,groq:openai/gpt-oss-120b@0,cerebras:gpt-oss-120b@0
REVOLVER_LLM_ORDER=
# Пусто = groq:whisper-large-v3,groq:whisper-large-v3-turbo,deepgram,assemblyai (можно добавить elevenlabs)
REVOLVER_STT_ORDER=
REVOLVER_COOLDOWN_SEC=600        # остывание эндпоинта после сбоя, если сервер не прислал Retry-After
REVOLVER_LLM_TIMEOUT_SEC=300     # таймаут одного запроса к бесплатному LLM (после него — следующий)
REVOLVER_IMAGE_MAX_PX=1024       # кадры ужимаются до этой длинной стороны (меньше токенов и размер запроса)

# ---- Мессенджеры ----
TELEGRAM_BOT_TOKEN=              # пусто = бот выключен, уведомления пишутся в лог/БД
TELEGRAM_MODE=polling            # polling | webhook
TELEGRAM_WEBHOOK_URL=
WHATSAPP_ENABLED=false           # Meta Cloud API, заготовка
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
TELEGRAM_WEBHOOK_SECRET=         # режим webhook: секрет в пути /api/telegram/webhook/{secret}
TELEGRAM_BOT_USERNAME=           # необязательно: имя бота для deep-link, если не хотим вызывать getMe
MESSAGING_PROVIDER=              # пусто = реальные провайдеры по каналу; mock = все сообщения в память (тесты, сидирование)

# ---- Дополнительно (есть разумные значения по умолчанию) ----
STAFF_TOKEN_TTL_DAYS=7
PARENT_TOKEN_TTL_DAYS=30
MAGIC_LINK_TTL_HOURS=72
MEDIA_TOKEN_TTL_MINUTES=10       # короткоживущий токен для ?access_token= у /api/media/* (кадры, видео)
PIPELINE_STALE_MINUTES=30        # урок в промежуточном статусе дольше этого считается брошенным и может быть перезапущен
RATE_LIMIT_ENABLED=true          # лимиты на /api/auth/login, /api/auth/register-center, /api/parent/auth/exchange (в APP_ENV=test выключены)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT_SEC=3600
LLM_MAX_FRAMES=20                # сколько кадров уходит в мультимодальный промпт
LLM_EFFORT=high                  # anthropic: low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SEC=600
OPENAI_LLM_MODEL=gpt-5           # LLM_PROVIDER=openai
OPENAI_STT_MODEL=whisper-1       # STT_PROVIDER=openai: whisper-1 | gpt-4o-transcribe | gpt-4o-transcribe-diarize
DEEPGRAM_MODEL=nova-3
ELEVENLABS_STT_MODEL=scribe_v1
YANDEX_STT_MODEL=general
WORKER_POLL_INTERVAL_SEC=2       # PIPELINE_MODE=worker
WORKER_CONCURRENCY=2             # сколько уроков воркер обрабатывает одновременно (1 для whisper_local на CPU)
WORKER_STALE_JOB_HOURS=3
